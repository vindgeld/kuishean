rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // Teachers = emails listed in /teachers/{email} (add docs by hand in the console).
    // email_verified is intentionally not required: Google accounts are always verified,
    // and PIN (email/password) accounts only work for emails already on this allowlist,
    // which is the actual security boundary.
    function isTeacher() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.token.email));
    }
    function quizOf(id) { return get(/databases/$(database)/documents/quizzes/$(id)).data; }

    match /teachers/{email} {
      allow read: if isSignedIn() && request.auth.token.email == email;
      allow write: if false;
    }

    // Public PIN -> quizId lookup. A code cannot be re-pointed at a different quiz.
    match /quizCodes/{pinCode} {
      allow read: if true;
      allow create: if isTeacher();
      allow update: if isTeacher() && resource.data.quizId == request.resource.data.quizId;
      allow delete: if isTeacher();
    }

    match /quizzes/{quizId} {
      allow read: if resource.data.published == true || isTeacher();
      allow write: if isTeacher();

      match /submissions/{subId} {
        allow read: if isTeacher() || (isSignedIn() && request.auth.uid == subId);
        allow create: if isSignedIn()
          && request.auth.uid == subId
          && quizOf(quizId).published == true
          && (quizOf(quizId).settings.get('opensAt', 0) == 0
              || request.time.toMillis() >= quizOf(quizId).settings.get('opensAt', 0))
          && (quizOf(quizId).settings.get('closesAt', 0) == 0
              || request.time.toMillis() <= quizOf(quizId).settings.get('closesAt', 0) + 120000)
          && request.resource.data.keys().hasOnly(['name', 'answers', 'startedAt', 'durationSec', 'submittedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.answers is map
          && request.resource.data.submittedAt == request.time;
        allow update, delete: if isTeacher();
      }
    }

    // Answer keys: teachers, or a student who has already submitted
    match /quizKeys/{quizId} {
      allow read: if isTeacher()
        || (isSignedIn() && exists(/databases/$(database)/documents/quizzes/$(quizId)/submissions/$(request.auth.uid)));
      allow write: if isTeacher();
    }
  }
}
